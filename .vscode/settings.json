{
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [],
  "python.testing.cwd": "/opt/odoo",
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/node_modules/**": true,
    "**/odoo/**": true
  },
  "search.exclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/node_modules/**": true,
    "**/odoo/**": true,
    "storage/**": true,
  },
  "search.useIgnoreFiles": false,
  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#714B67",
    "titleBar.border": "#ebe8e8",
    "titleBar.inactiveBackground": "#714B67",
    "titleBar.activeForeground": "#ebe8e8",
    "statusBar.background": "#714B67",
    "statusBar.debuggingBackground": "#714B67",
    "statusBar.noFolderBackground": "#714B67",
    "statussBar.prominentBackground": "#714B67",
    "statusBar.foreground": "#ebe8e8"
  }
}