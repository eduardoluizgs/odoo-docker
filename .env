ODOO_ENV=development
ODOO_IMAGE=odoo:development-v19
ODOO_DATABASE=odoo
ODOO_DATABASE_LIST=Y
ODOO_DATABASE_FILTER=^odoo.*$
ODOO_DATABASE_INIT=N
ODOO_MODULES=odoo_sample_module
ODOO_UPDATE=N

POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_HOST=odoo_postgres
POSTGRES_PORT=5432

INTERNAL_IP=
EXTERNAL_IP=

DOCKER_COMPOSE_FILE_GENERAL=
DOCKER_COMPOSE_FILE_DEBUG=
